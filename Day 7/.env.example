# Grok/Groq API Configuration
# Replace with your actual xAI key (starting with xai-) or Groq key (starting with gsk_)
GROK_API_KEY=your_api_key_here

# Optional: override default model
# For xAI: default is grok-2-1212
# For Groq: default is llama-3.3-70b-versatile
# GROK_MODEL=grok-2-1212

# Port to serve the FastAPI app
PORT=8000
