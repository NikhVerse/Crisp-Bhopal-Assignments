# LLM Configuration
# Set either GROQ_API_KEY or GEMINI_API_KEY. Groq is preferred.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=groq  # Options: groq, gemini, or mock

# Weather Configuration
# Get a free API key from https://openweathermap.org/
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Google OAuth Credentials
# Create a project at https://console.cloud.google.com/, enable Calendar API,
# and configure OAuth 2.0 credentials with redirect URI: http://localhost:8000/api/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Database Settings
DATABASE_URL=sqlite:///./assistant.db

# FastAPI Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
