# ─────────────────────────────────────────────────────────────────────────────
# AI Email Auto Responder — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n Configuration ─────────────────────────────────────────────────────────
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123

# ── Gmail OAuth 2.0 ──────────────────────────────────────────────────────────
# Obtain from Google Cloud Console → APIs & Services → Credentials
# Enable Gmail API and create an OAuth 2.0 Client (Desktop / Web Application)
GMAIL_CLIENT_ID=your_gmail_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
GMAIL_USER_EMAIL=your_email@gmail.com

# ── Ollama LLM Configuration ──────────────────────────────────────────────────
# Available models: llama3.1, llama3.2, qwen3, mistral, gemma3
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://ollama:11434

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=email_memory
QDRANT_API_KEY=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FOLDER=/data/logs
LOG_LEVEL=info

# ── Application Settings ──────────────────────────────────────────────────────
# How often to poll Gmail (in minutes)
POLL_INTERVAL_MINUTES=1

# Auto-send without approval (true/false) — Keep false for safety!
AUTO_SEND_ENABLED=false

# Maximum number of emails to fetch per poll
MAX_EMAILS_PER_POLL=10

# ── Timezone ───────────────────────────────────────────────────────────────────
TZ=Asia/Kolkata
